{
  "info": {
    "name": "Campus Lost and Found Portal API",
    "_postman_id": "campus-lost-found-api-2026",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "itemId",
      "value": "REPLACE_WITH_ITEM_ID"
    },
    {
      "key": "claimId",
      "value": "REPLACE_WITH_CLAIM_ID"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Health check succeeds', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Register student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Postman Student\",\"email\":\"postman.student@example.com\",\"password\":\"Student123!\"}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Register returns 201 or existing account 409', () => pm.expect([201,409]).to.include(pm.response.code));",
              "if (pm.response.code === 201) pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"postman.student@example.com\",\"password\":\"Student123!\"}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Get all items",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/items?sort=newest"
      }
    },
    {
      "name": "Get one item",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/items/{{itemId}}"
      }
    },
    {
      "name": "Create item",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "title",
              "value": "Postman Test Umbrella",
              "type": "text"
            },
            {
              "key": "category",
              "value": "Other",
              "type": "text"
            },
            {
              "key": "description",
              "value": "Black umbrella with a curved handle for API testing.",
              "type": "text"
            },
            {
              "key": "location",
              "value": "Block C",
              "type": "text"
            },
            {
              "key": "date",
              "value": "2026-11-27",
              "type": "text"
            },
            {
              "key": "type",
              "value": "found",
              "type": "text"
            }
          ]
        },
        "url": "{{baseUrl}}/api/items"
      }
    },
    {
      "name": "Update item",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"status\":\"returned\"}"
        },
        "url": "{{baseUrl}}/api/items/{{itemId}}"
      }
    },
    {
      "name": "Submit claim",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"itemId\":\"{{itemId}}\",\"message\":\"I can identify this item because it has my initials and a unique mark.\"}"
        },
        "url": "{{baseUrl}}/api/claims"
      }
    },
    {
      "name": "Get my claims",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/claims/mine"
      }
    },
    {
      "name": "Unauthorized protected request",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Unauthorized request is rejected', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"admin@campus.edu\",\"password\":\"ChangeMe123!\"}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Admin login succeeds', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin statistics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/stats"
      }
    }
  ]
}