{
  "info": {
    "name": "Campus Lost and Found Portal API",
    "_postman_id": "campus-lost-found-2026",
    "description": "API test collection. Set baseUrl and run login before protected calls.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    },
    {
      "key": "claimId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Register student (use a fresh email)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/register",
        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"Postman Student\", \"email\": \"postman.student@example.com\", \"password\": \"Student123\"}"
        }
      },
      "event": []
    },
    {
      "name": "02 Login student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"student@campus.edu\", \"password\": \"Student@123\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Login succeeds',()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token',pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@campus.edu\", \"password\": \"Admin@123\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin login succeeds',()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set('adminToken',pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Unauthorized current user",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Unauthorized request rejected',()=>pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Current user profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}"
          }
        ],
        "url": "{{baseUrl}}/auth/me"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Profile returned',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Invalid item input",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/items",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"\", \"category\": \"Books\", \"description\": \"\", \"location\": \"\", \"date\": \"bad-date\", \"type\": \"lost\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Validation error returned',()=>pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Retrieve items",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/items?sort=newest"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Items list returned',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Create item",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/items",
        "body": {
          "mode": "raw",
          "raw": "{\"title\": \"Postman test notebook\", \"category\": \"Books\", \"description\": \"Blue notebook created during API testing\", \"location\": \"Block B\", \"date\": \"2026-11-26\", \"type\": \"found\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Item created',()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set('itemId',pm.response.json().item._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Retrieve created item",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/items/{{itemId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Item retrieved',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Update created item",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/items/{{itemId}}",
        "body": {
          "mode": "raw",
          "raw": "{\"location\": \"Block C - Updated\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Item updated',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Submit claim",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/claims",
        "body": {
          "mode": "raw",
          "raw": "{\"itemId\": \"{{itemId}}\", \"message\": \"I can identify a sticker on this notebook.\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Claim accepted or duplicate protected',()=>pm.expect([201,409,400]).to.include(pm.response.code));",
              "if(pm.response.code===201)pm.collectionVariables.set('claimId',pm.response.json().claim._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "12 My claims",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}"
          }
        ],
        "url": "{{baseUrl}}/claims/mine"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Claims returned',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Admin statistics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}"
          }
        ],
        "url": "{{baseUrl}}/admin/stats"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin stats accessible',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Admin endpoint rejects student",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}"
          }
        ],
        "url": "{{baseUrl}}/admin/stats"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Forbidden for normal user',()=>pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Delete test item",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}"
          }
        ],
        "url": "{{baseUrl}}/items/{{itemId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Item deleted',()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    }
  ]
}